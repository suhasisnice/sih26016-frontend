# Copy to .env for local development.

# Where the API lives. Vite inlines this at BUILD time, not run time — a
# deployed build has to be built with the deployed API's URL, changing it
# afterwards means rebuilding.
VITE_API_URL=http://localhost:8000

# Shows the clickable demo-account list on the login page. Must be exactly
# "true" to render.
#
# Leave it unset/false on any public deployment. The list publishes six
# working usernames and the shared password, one of them a State
# Administrator — fine on a laptop, an open door on a public URL.
VITE_SHOW_DEMO_ACCOUNTS=true

# The password those demo accounts were seeded with. Only read when the list
# above is showing, so it matters locally and nowhere else. Leave it unset
# unless you seeded with a SEED_PASSWORD other than the default.
# VITE_DEMO_PASSWORD=demo1234
