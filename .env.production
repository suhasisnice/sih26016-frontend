# Used by `npm run build` unless overridden by the host's own env vars.
# Render injects VITE_API_URL from the dashboard, which takes precedence.

VITE_API_URL=https://sih26016-api.onrender.com

# Pinned to "false", NOT left absent.
#
# Leaving it absent was the previous reasoning and it is wrong, because Vite
# loads plain `.env` in EVERY mode — including production. On a machine whose
# `.env` sets VITE_SHOW_DEMO_ACCOUNTS=true for local work, `npm run build`
# therefore inherited it and baked six working usernames and their shared
# password into the production bundle. Verified: with `.env` present the
# strings are in dist/assets; with it gone they are tree-shaken out.
#
# A deployment from GitHub never had `.env` (it is gitignored), so the public
# site was not exposed — but any locally-built dist was, and "safe as long as
# nobody builds it here" is not a property worth relying on. `.env.production`
# beats `.env` for the same key, so this line closes it in every mode.
VITE_SHOW_DEMO_ACCOUNTS=false
